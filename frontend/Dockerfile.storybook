# Storybook用 Dockerfile
FROM node:20-alpine

# 必要なパッケージをインストール
RUN apk add --no-cache git curl

# 作業ディレクトリ設定
WORKDIR /app

# パッケージファイルのコピー
COPY frontend/package.json frontend/pnpm-lock.yaml ./

# pnpm インストール
RUN npm install -g pnpm
RUN pnpm install

# ソースコードのコピー  
COPY frontend/ .

# Storybookポート公開
EXPOSE 6006

# ヘルスチェックの追加
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:6006 || exit 1

# Storybook開発サーバー起動
CMD ["pnpm", "storybook", "--host", "0.0.0.0", "--port", "6006", "--no-open"]